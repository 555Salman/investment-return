DATABASE_URL=postgresql://user:password@localhost:5432/multicurrency_db
REDIS_URL=redis://localhost:6379

# REQUIRED in production (debug=False). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-256-bit-random-secret-here

OPENAI_API_KEY=your-openai-key-here   # Used by LangChain agents

# Frontend (Vite) — set in deployment environment (Vercel / Netlify)
# Leave unset for local dev (Vite proxy routes /api to localhost:8000)
VITE_API_BASE_URL=https://your-backend.com/api
